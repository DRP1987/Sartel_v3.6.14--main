{
  "configurations": [
    {
      "name": "Liebherr_FMS_LTM models from 2018 (Engine-Upper and LMB override status)",
      "info_pdf": "config/docs/Liebherr/FMS_Liebherr.pdf",
      "matched_crane_models": [
        "All LTM models newer than 2018",
        "should have the FMS connector installed.", 
        "See installation example_LTM newer than 2018",
        "on tap Documentation."
      ],
      "signals": [
        {
          "name": "Engine On_RPM<200",
          "can_id": "0x18F00401",
          "match_type": "range",
          "protocol": "j1939",
          "byte_index": 4,
          "min_value": "0x06",
          "max_value": "0xFF"
        },
        {
          "name": "Crane-Upper running",
          "can_id": "0x18FFE001",
          "protocol": "j1939",
          "match_type": "bit",
          "byte_index": 0,
          "bit_index": 0,
          "bit_value": 1
        },
        {
          "name": "LMB override",
          "can_id": "0x18FFE001",
