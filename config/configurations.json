          "bit_index": 1,
          "bit_value": 1
        }
      ],
      "pgn_channels": [
        {
          "label": "Engine RPM",
          "pgn": "0xF004",
          "bytes": [3, 4],
          "byte_order": "little_endian",
          "scale": 0.125,
          "offset": 0.0,
          "unit": "rpm",
          "format": "{:.2f}"
        },
        {
          "label": "Engine Oil pressure",
          "pgn": "0xFEEF",
