          "byte_order": "little_endian",
          "scale": 0.05,
          "offset": 0,
          "unit": "h",
          "format": "{:.2f}"
        },
        {
          "label": "Engine Total HR fuel used",
          "pgn": "0xFD09",
          "bytes": [4,5,6,7],
          "byte_order": "little_endian",
          "scale": 0.001,
          "offset": 0,
          "unit": "l",
          "format": "{:.2f}"
        },
        {
          "label": "Engine Total fuel used",
          "pgn": "0xFEE9",
          "bytes": [4,5,6,7],
          "byte_order": "little_endian",
          "scale": 0.5,
          "offset": 0,
          "unit": "l",
          "format": "{:.2f}"
        },
        {
