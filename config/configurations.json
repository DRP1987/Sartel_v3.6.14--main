          "byte_order": "little_endian",
          "scale": 0.04,
          "offset": 0,
          "unit": "Bar",
          "format": "{:.2f}"
        },
        {
          "label": "Engine Coolant temp",
          "pgn": "0xFEEE",
          "bytes": [0],
          "byte_order": "little_endian",
          "scale": 1,
          "offset": -40,
          "unit": "°C",
          "format": "{:.2f}"
        },
        {
          "label": "Engine Oil temp",
          "pgn": "0xFEEE",
          "bytes": [2,3],
          "byte_order": "little_endian",
          "scale": 0.03125,
          "offset": -273,
          "unit": "°C",
          "format": "{:.2f}"
        },
        {
          "label": "Engine Fuel temp",
          "pgn": "0xFEEE",
          "bytes": [1],
          "byte_order": "little_endian",
          "scale": 1,
          "offset": -40,
          "unit": "°C",
          "format": "{:.2f}"
        },
        {
          "label": "Engine Coolant level",
          "pgn": "0xFEEF",
          "bytes": [7],
          "byte_order": "little_endian",
          "scale": 0.4,
          "offset": 0,
          "unit": "%",
          "format": "{:.2f}"
        },
        {
          "label": "Engine Total hours",
          "pgn": "0xFEE5",
